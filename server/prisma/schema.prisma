// Skema Prisma untuk aplikasi manajemen proyek Gantt Chart.
// Tanggal disimpan sebagai string ISO "YYYY-MM-DD"; kolom enum memakai String
// dan divalidasi lewat zod di paket shared.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  projects     Project[]
}

model Project {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String?
  startDate   String
  // Daftar angka hari akhir pekan dipisah koma: 0=Minggu ... 6=Sabtu
  weekendDays String     @default("0,6")
  createdAt   DateTime   @default(now())
  tasks       Task[]
  holidays    Holiday[]
  resources   Resource[]

  @@index([ownerId])
}

model Holiday {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  date      String
  name      String

  @@unique([projectId, date])
  @@index([projectId])
}

model Task {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parentId       String?
  parent         Task?    @relation("Subtask", fields: [parentId], references: [id], onDelete: Cascade)
  children       Task[]   @relation("Subtask")
  position       Int
  name           String
  description    String?
  durationDays   Int
  // Batas "mulai paling awal" yang diisi pengguna
  startDate      String
  // Hasil hitung mesin shared
  scheduledStart String
  scheduledEnd   String
  priority       String   @default("MEDIUM")
  color          String   @default("#2563EB")
  progress       Int      @default(0)
  optimisticDays  Int?
  pessimisticDays Int?

  dependenciesAsPredecessor Dependency[] @relation("Predecessor")
  dependenciesAsSuccessor   Dependency[] @relation("Successor")
  assignments               Assignment[]

  @@index([projectId])
  @@index([parentId])
}

model Dependency {
  id            String @id @default(cuid())
  predecessorId String
  successorId   String
  // "FS" (finish-to-start) atau "SS" (start-to-start)
  type          String @default("FS")
  lagDays       Int    @default(0)

  predecessor Task @relation("Predecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("Successor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([predecessorId])
  @@index([successorId])
}

model Resource {
  id        String       @id @default(cuid())
  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  email     String
  role      String
  // Gaji per bulan dalam rupiah
  salary    Int
  assignments Assignment[]

  @@index([projectId])
}

model Assignment {
  id                String   @id @default(cuid())
  taskId            String
  resourceId        String
  allocationPercent Int      @default(100)
  task              Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  resource          Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([taskId, resourceId])
  @@index([taskId])
  @@index([resourceId])
}
